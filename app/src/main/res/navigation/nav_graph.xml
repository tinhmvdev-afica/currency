<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.currency.presentation.splash.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.currency.presentation.onboarding.OnboardingFragment"
        android:label="Onboarding">

        <action
            android:id="@+id/action_onboardingFragment_to_onboardingLanguageFragment"
            app:destination="@id/onboardingLanguageFragment" />

        <action
            android:id="@+id/action_onboardingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/onboardingLanguageFragment"
        android:name="com.example.currency.presentation.onboarding.OnboardingLanguageFragment"
        android:label="OnboardingLanguage">

        <action
            android:id="@+id/action_onboardingLanguageFragment_to_onboardingCurrenciesFragment"
            app:destination="@id/onboardingCurrenciesFragment" />

    </fragment>

    <fragment
        android:id="@+id/onboardingCurrenciesFragment"
        android:name="com.example.currency.presentation.onboarding.OnboardingCurrenciesFragment"
        android:label="OnboardingCurrencies">

        <action
            android:id="@+id/action_onboardingCurrenciesFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.currency.presentation.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_marketChartFragment"
            app:destination="@id/marketChartFragment" />

    </fragment>
    <fragment
        android:id="@+id/marketChartFragment"
        android:name="com.example.currency.presentation.markets.chart.MarketChartFragment"
        android:label="Market Chart">

    </fragment>

</navigation>
