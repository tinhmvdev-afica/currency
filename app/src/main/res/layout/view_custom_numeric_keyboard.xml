<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="4"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Row 1 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn1"
        style="@style/KeyStyle"
        android:text="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn2"
        style="@style/KeyStyle"
        android:text="2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn3"
        style="@style/KeyStyle"
        android:text="3" />

    <!-- Row 2 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn4"
        style="@style/KeyStyle"
        android:text="4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn5"
        style="@style/KeyStyle"
        android:text="5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn6"
        style="@style/KeyStyle"
        android:text="6" />

    <!-- Row 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn7"
        style="@style/KeyStyle"
        android:text="7" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn8"
        style="@style/KeyStyle"
        android:text="8" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn9"
        style="@style/KeyStyle"
        android:text="9" />

    <!-- Row 4: Dấu chấm, Số 0, Nút xóa lùi (Backspace) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDot"
        style="@style/KeyStyle"
        android:text="." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn0"
        style="@style/KeyStyle"
        android:text="0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackspace"
        style="@style/KeyStyle"
        app:icon="@drawable/ic_backspace"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/brand_primary" />

</GridLayout>