<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutLanguageItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_language_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Flag Emoji Box -->
    <TextView
        android:id="@+id/tvLanguageFlag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_input_box"
        android:gravity="center"
        android:textSize="20sp"
        tools:text="🇻🇳" />

    <!-- Language Name & Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLanguageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Tiếng Việt" />

        <TextView
            android:id="@+id/tvLanguageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/content_secondary"
            android:textSize="11sp"
            tools:text="Vietnamese • Việt Nam" />
    </LinearLayout>

    <!-- Selected Checkmark -->
    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
